    "android:prod": "RELEASE_CHANNEL=prod expo run:android --variant release",
    "ios:dev": "RELEASE_CHANNEL=dev expo run:ios",
    "ios:preview": "RELEASE_CHANNEL=preview expo run:ios --configuration Release",
    "ios:prod": "RELEASE_CHANNEL=prod expo run:ios --configuration Release"
  },
