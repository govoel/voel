  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "check-types": "expo customize tsconfig.json && tsc --noEmit",
    "test": "vitest run --config vitest.rn.config.ts src/components && bun --bun run vitest run --config vitest.rn-mocks.config.ts src/services/accounts src/services/auth-client src/services/database/library src/services/swr.test.ts",
