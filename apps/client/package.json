{
  "name": "voel",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "check-types": "expo customize tsconfig.json && ../../node_modules/.bin/tsc --noEmit",
    "test": "vitest run --config vitest.rn.config.ts src/components && bun --bun run vitest run --config vitest.rn-mocks.config.ts src/services/accounts",
    "start": "RELEASE_CHANNEL=dev expo start",
    "android:dev": "RELEASE_CHANNEL=dev expo run:android",
