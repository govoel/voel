{
  "name": "@repo/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#src/*": "./src/*"
  },
  "exports": {
    ".": "./src/index.ts",
    "./services/config.ts": "./src/services/config.ts"
  },
  "scripts": {
    "dev": "portless server --app-port 3000 bun run --watch src/index.ts",
    "build": "bun build src/index.ts --outdir=dist --target=bun --format=esm --minify --sourcemap",
    "check-types": "tsc --noEmit",
    "test": "bun --bun run vitest"
  },
  "dependencies": {
    "@effect/platform-bun": "4.0.0",
    "@govoel/plugins": "workspace:*",
    "@govoel/turso-database": "0.8.1",
    "@repo/auth-api": "workspace:*",
    "@repo/effect-turso": "workspace:*",
    "@repo/spec-api": "workspace:*",
    "@yielded/auth": "0.1.0-beta.30",
    "@yielded/auth-persistence": "0.1.0-beta.30",
    "@yielded/crypto": "0.1.0-beta.30",
    "effect": "4.0.0"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0",
    "@repo/effect-turso-sync-bun": "workspace:*",
    "@repo/tsconfig": "workspace:*",
    "bun-types": "1.4.2",
    "portless": "0.15.7",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
