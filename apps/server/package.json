{
  "name": "@repo/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#src/*": "./src/*"
  },
  "exports": {
    ".": "./src/index.ts",
    "./services/config.ts": "./src/services/config.ts"
  },
  "scripts": {
    "dev": "portless server --app-port 3000 bun run --watch src/index.ts",
    "build": "bun build src/index.ts --outdir=dist --target=bun --format=esm --minify --sourcemap",
    "check-types": "tsc --noEmit",
    "test": "bun --bun run vitest"
  },
  "dependencies": {
    "@effect/platform-bun": "4.0.0-rc.110",
    "@repo/auth-api": "workspace:*",
    "@repo/effect-kysely": "workspace:*",
    "@repo/source-tap": "workspace:*",
    "@repo/spec-api": "workspace:*",
    "effect": "4.0.0-rc.110"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0-rc.110",
    "@repo/tsconfig": "workspace:*",
    "bun-types": "1.3.14",
    "portless": "0.15.5",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
