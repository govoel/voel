{
  "name": "@repo/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#src/*": "./src/*"
  },
  "scripts": {
    "dev": "portless server --app-port 3000 bun run --watch src/index.ts",
    "build": "bun build src/index.ts --outdir=dist --target=bun --format=esm --minify --sourcemap",
    "check-types": "tsc --noEmit",
    "test": "bun --bun run vitest"
  },
  "dependencies": {
    "@effect/platform-bun": "4.0.6",
    "@govoel/plugins": "workspace:*",
    "@govoel/turso-database": "0.8.3",
    "@repo/auth-api": "workspace:*",
    "@repo/effect-turso": "workspace:*",
    "@repo/spec-api": "workspace:*",
    "effect": "4.0.6"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.6",
    "@repo/effect-turso-sync-bun": "workspace:*",
    "@repo/tsconfig": "workspace:*",
    "bun-types": "1.4.4",
    "portless": "0.15.11",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
