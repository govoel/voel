{
  "name": "@repo/atom-devtools-plugin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/react-native/index.cjs",
  "module": "./dist/react-native/index.js",
  "types": "./dist/react-native/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/react-native/index.d.ts",
      "import": "./dist/react-native/index.js",
      "require": "./dist/react-native/index.cjs"
    },
    "./sdk": {
      "development": "./sdk.ts",
      "types": "./dist/sdk/index.d.ts",
      "import": "./dist/sdk/index.js",
      "require": "./dist/sdk/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rozenite build",
    "check-types": "tsc --noEmit && effect-language-service diagnostics --project tsconfig.json",
    "dev": "rozenite dev",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@effect/atom-react": "4.0.0-beta.102",
    "@repo/atom-devtools-core": "workspace:*",
    "@rozenite/agent-bridge": "1.13.0",
    "@rozenite/agent-shared": "1.13.0",
    "@rozenite/plugin-bridge": "1.13.0",
    "effect": "4.0.0-beta.102",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0"
  },
  "devDependencies": {
    "@effect/language-service": "0.87.1",
    "@repo/tsconfig": "workspace:*",
    "@rozenite/vite-plugin": "1.13.0",
    "@tailwindcss/postcss": "4.2.2",
    "@types/react": "~19.2.2",
    "@types/react-dom": "~19.2.2",
    "bun-types": "1.3.14",
    "postcss": "8.5.6",
    "react-native-web": "0.21.2",
    "rozenite": "1.13.0",
    "tailwindcss": "4.2.2",
    "typescript": "6.0.3",
    "vite": "7.3.1",
    "vitest": "4.1.10"
  }
}
