{
  "name": "@repo/effect-atom-devtools-core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#src/*": "./src/*"
  },
  "exports": {
    ".": "./src/index.ts",
    "./atom-dev-tools": "./src/atom-dev-tools.ts",
    "./rpc": "./src/rpc.ts",
    "./rpc-server": "./src/rpc-server.ts"
  },
  "scripts": {
    "check-types": "tsc --noEmit && effect-language-service diagnostics --project tsconfig.json",
    "test": "bun --bun run vitest"
  },
  "dependencies": {
    "effect": "4.0.0-rc.108"
  },
  "devDependencies": {
    "@effect/language-service": "0.87.2",
    "@effect/vitest": "4.0.0-rc.108",
    "@repo/tsconfig": "workspace:*",
    "bun-types": "1.3.14",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
