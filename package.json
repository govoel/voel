{
  "name": "voel",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "lint": "oxlint . --ignore-pattern .repos/** --type-aware --type-check --deny-warnings",
    "lint:fix": "oxlint . --ignore-pattern .repos/** --fix --type-aware --type-check --deny-warnings",
    "test": "node .oxlint/rules/deterministic-identifiers.test.mts && node .oxlint/rules/no-schema-struct-assignment.test.mts && node .oxlint/rules/schema-class-brand.test.mts",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "build": "turbo run build",
    "clean": "find . \\( -type d -name node_modules -o -type d -name .turbo \\) -prune -exec rm -rf -- {} \\;",
    "prepare": "effect-tsgo patch --no-typescript --oxlint"
  },
  "devDependencies": {
    "@effect/tsgo": "0.36.5",
    "@oxlint/plugins": "1.78.0",
    "agent-browser": "0.34.0",
    "agent-device": "0.20.10",
    "bun-types": "1.4.0",
    "effect": "4.0.0-rc.112",
    "eslint-plugin-turbo": "2.10.11",
    "opensrc": "0.7.3",
    "oxfmt": "0.65.0",
    "oxlint": "1.78.0",
    "oxlint-tsgolint": "7.0.2001",
    "turbo": "2.10.11",
    "typescript": "7.0.2"
  },
  "engines": {
    "bun": "1.4.0"
  },
  "packageManager": "bun@1.4.0"
}
