{
  "name": "voel",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "lint": "oxlint . --ignore-pattern .repos/** --type-aware --type-check --deny-warnings",
    "lint:fix": "oxlint . --ignore-pattern .repos/** --fix --type-aware --type-check --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "build": "turbo run build",
    "clean": "find . \\( -type d -name node_modules -o -type d -name .turbo \\) -prune -exec rm -rf -- {} \\;"
  },
  "devDependencies": {
    "@effect/language-service": "0.87.2",
    "agent-browser": "0.34.0",
    "agent-device": "0.20.8",
    "eslint-plugin-turbo": "2.10.9",
    "opensrc": "0.7.3",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "oxlint-tsgolint": "0.25.0",
    "turbo": "2.10.9",
    "typescript": "6.0.3"
  },
  "engines": {
    "bun": "1.3.14"
  },
  "packageManager": "bun@1.3.14"
}
