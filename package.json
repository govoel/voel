{
  "name": "voel",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "lint": "oxlint . --ignore-pattern .repos/** --type-aware --type-check --deny-warnings",
    "lint:fix": "oxlint . --ignore-pattern .repos/** --fix --type-aware --type-check --deny-warnings",
    "test": "node --test .oxlint/rules/*.test.mts",
    "format": "oxfmt && oxlint --config .oxlint.sql.json --fix .",
    "format:check": "oxfmt --check && oxlint --config .oxlint.sql.json",
    "build": "turbo run build",
    "clean": "find . \\( -type d -name node_modules -o -type d -name .turbo \\) -prune -exec rm -rf -- {} \\;",
    "prepare": "effect-tsgo patch --no-typescript --oxlint"
  },
  "devDependencies": {
    "@effect/tsgo": "0.53.4",
    "@oxlint/plugins": "1.88.0",
    "agent-browser": "0.39.1",
    "agent-device": "0.21.28",
    "bun-types": "1.4.3",
    "effect": "4.0.5",
    "eslint-plugin-sql": "3.4.1",
    "eslint-plugin-turbo": "2.11.9",
    "opensrc": "0.7.3",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "turbo": "2.11.9",
    "typescript": "7.0.2"
  },
  "engines": {
    "bun": "1.4.3"
  },
  "packageManager": "bun@1.4.3",
  "patchedDependencies": {
    "eslint-plugin-sql@3.4.1": "patches/eslint-plugin-sql@3.4.1.patch",
    "rozenite@2.5.0": "patches/rozenite@2.5.0.patch",
    "@tursodatabase/sync-react-native@0.8.3": "patches/@tursodatabase%2Fsync-react-native@0.8.3.patch"
  }
}
