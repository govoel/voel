{
  "name": "voel",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "lint": "oxlint . --ignore-pattern .repos/** --type-aware --type-check --deny-warnings",
    "lint:fix": "oxlint . --ignore-pattern .repos/** --fix --type-aware --type-check --deny-warnings",
    "test": "node --test .oxlint/rules/*.test.mts",
    "format": "oxfmt && oxlint --config .oxlint.sql.json --fix .",
    "format:check": "oxfmt --check && oxlint --config .oxlint.sql.json",
    "build": "turbo run build",
    "clean": "find . \\( -type d -name node_modules -o -type d -name .turbo \\) -prune -exec rm -rf -- {} \\;",
    "prepare": "effect-tsgo patch --no-typescript --oxlint"
  },
  "devDependencies": {
    "@effect/tsgo": "0.45.0",
    "@oxlint/plugins": "1.82.0",
    "agent-browser": "0.38.1",
    "agent-device": "0.21.7",
    "bun-types": "1.4.2",
    "effect": "4.0.0-rc.117",
    "eslint-plugin-sql": "3.4.1",
    "eslint-plugin-turbo": "2.11.2",
    "opensrc": "0.7.3",
    "oxfmt": "0.70.0",
    "oxlint": "1.82.0",
    "oxlint-tsgolint": "7.0.2001",
    "turbo": "2.11.2",
    "typescript": "7.0.2"
  },
  "overrides": {
    "@effect/platform-node-shared": "4.0.0-rc.117"
  },
  "engines": {
    "bun": "1.4.2"
  },
  "packageManager": "bun@1.4.2",
  "patchedDependencies": {
    "@tursodatabase/sync-react-native@0.8.0-pre.11": "patches/@tursodatabase%2Fsync-react-native@0.8.0-pre.11.patch",
    "eslint-plugin-sql@3.4.1": "patches/eslint-plugin-sql@3.4.1.patch",
    "expo-font@58.0.2": "patches/expo-font@58.0.2.patch",
    "expo-image@58.0.4": "patches/expo-image@58.0.4.patch",
    "expo-router@58.0.6": "patches/expo-router@58.0.6.patch",
    "expo-web-browser@58.0.2": "patches/expo-web-browser@58.0.2.patch"
  }
}
