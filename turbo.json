{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "remoteCache": { "enabled": true },
  "tasks": {
    "build": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "test": {
      "cache": true,
      "dependsOn": ["^test"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputLogs": "errors-only"
    },
    "//#test": {
      "cache": true,
      "inputs": ["$TURBO_DEFAULT$", "!.repos/effect/**"],
      "outputLogs": "errors-only"
    },
    "voel#test": {
      "cache": true,
      "dependsOn": ["^test", "@repo/effect-atom-devtools-rozenite#build"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputLogs": "errors-only"
    },
    "//#lint": {
      "cache": true,
      "dependsOn": ["@repo/effect-atom-devtools-rozenite#build"],
      "inputs": ["$TURBO_DEFAULT$", "!.repos/effect/**", "$TURBO_ROOT$/.oxlintrc.json"],
      "outputLogs": "errors-only"
    },
    "//#lint:fix": {
      "cache": false,
      "dependsOn": ["@repo/effect-atom-devtools-rozenite#build"]
    },
    "//#format": {
      "cache": false
    },
    "//#format:check": {
      "cache": false,
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/.oxfmtrc.json"]
    },
    "check-types": {
      "cache": true,
      "dependsOn": ["^check-types"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": ["*.tsbuildinfo"],
      "outputLogs": "errors-only"
    },
    "voel#check-types": {
      "cache": true,
      "dependsOn": ["^check-types", "@repo/effect-atom-devtools-rozenite#build"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": ["*.tsbuildinfo"],
      "outputLogs": "errors-only"
    },
    "voel#start": {
      "cache": false,
      "dependsOn": ["@repo/effect-atom-devtools-rozenite#build"],
      "persistent": true
    },
    "voel#android:dev": {
      "cache": false,
      "dependsOn": ["@repo/effect-atom-devtools-rozenite#build"],
      "persistent": true
    },
    "voel#android:preview": {
      "cache": false,
      "dependsOn": ["@repo/effect-atom-devtools-rozenite#build"],
      "persistent": true
    },
    "voel#android:prod": {
      "cache": false,
      "dependsOn": ["@repo/effect-atom-devtools-rozenite#build"],
      "persistent": true
    },
    "voel#ios:dev": {
      "cache": false,
      "dependsOn": ["@repo/effect-atom-devtools-rozenite#build"],
      "persistent": true
    },
    "voel#ios:preview": {
      "cache": false,
      "dependsOn": ["@repo/effect-atom-devtools-rozenite#build"],
      "persistent": true
    },
    "voel#ios:prod": {
      "cache": false,
      "dependsOn": ["@repo/effect-atom-devtools-rozenite#build"],
      "persistent": true
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
