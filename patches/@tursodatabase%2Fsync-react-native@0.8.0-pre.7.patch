@@ -293,6 +306,49 @@ class Statement {
     }
   }

+  /**
+   * Execute query and return all rows as positional value arrays.
+   *
+   * Unlike object rows, positional rows preserve projection order and
+   * duplicate column names.
+   */
+  async allValues(...params) {
+    if (this._finalized) {
+      throw new Error('Statement has been finalized');
+    }
+    if (this._execLock) {
+      await this._execLock.acquire();
+    }
+    try {
+      // Bind parameters inside the lock to prevent concurrent bind/execute races
+      if (params.length > 0) {
+        this.bind(...params);
+      }
+      const columnCount = this._statement.columnCount();
+      const rows = [];
+      while (true) {
+        const status = await this.stepWithIo();
+        if (status === _types.TursoStatus.ROW) {
+          const row = [];
+          for (let i = 0; i < columnCount; i++) {
+            row.push(this.readColumnValue(i));
+          }
+          rows.push(row);
+          continue;
+        }
+        if (status === _types.TursoStatus.DONE) {
+          return rows;
+        }
+        throw new Error(`Statement step failed with status: ${status}`);
+      }
+    } finally {
+      this._statement.reset();
+      if (this._execLock) {
+        this._execLock.release();
+      }
+    }
+  }
